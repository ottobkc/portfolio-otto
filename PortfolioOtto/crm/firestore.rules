rules_version = '2';
// Reglas de Firestore · proyecto mirardespaciocrm
// Se pegan a mano en Firebase Console → Firestore → Reglas (no se despliegan con Netlify).
// ADMIN_EMAIL: el email con el que entras al CRM.
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ottobkc@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Mapa de pegatinas de salidas.html: cualquiera puede verlo y añadir una.
    match /pegatinas/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['lat', 'lng', 'name', 'photo', 'createdAt'])
                    && request.resource.data.lat is number
                    && request.resource.data.lng is number;
    }

    // Registro de accesos: lo escriben las funciones de Netlify (con credenciales de servidor,
    // que no pasan por estas reglas). Desde el navegador solo puede leerlo el admin.
    match /accesos/{id} {
      allow read: if esAdmin();
      allow write: if false;
    }
    match /miembros_actividad/{id} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // Todo lo demás (CRM: events, people, signups…) solo para el admin.
    match /{document=**} {
      allow read, write: if esAdmin();
    }
  }
}
