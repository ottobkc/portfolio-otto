rules_version = '2';
// Reglas de Firestore · proyecto mirardespaciocrm
// Se pegan a mano en Firebase Console → Firestore → Reglas (no se despliegan con Netlify).
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ottobkc@gmail.com';
      // Nadie más puede crearse una cuenta: en Firebase → Authentication → Settings → User actions
      // está desactivado «Enable create (sign-up)». Así nadie puede registrarse con ningún email.
    }

    // Mapa de pegatinas de salidas.html: cualquiera puede verlo y añadir una.
    match /pegatinas/{id} {
      allow read: if true;
      // Cualquiera puede añadir un punto. Si trae foto, entra sin aprobar (fotoAprobada: false)
      // y solo el admin puede aprobarla, editarla o borrarla (regla general de abajo).
      allow create: if request.resource.data.keys().hasOnly(['lat', 'lng', 'name', 'photo', 'fotoAprobada', 'createdAt'])
                    && request.resource.data.lat is number
                    && request.resource.data.lng is number
                    && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
                    && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
                    && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 60))
                    && (!('fotoAprobada' in request.resource.data) || request.resource.data.fotoAprobada == false)
                    && (!('photo' in request.resource.data) || request.resource.data.photo == null
                        || (request.resource.data.photo is string
                            && request.resource.data.photo.size() < 400
                            && request.resource.data.fotoAprobada == false));
    }

    // Registro de accesos: lo escriben las funciones de Netlify (con credenciales de servidor,
    // que no pasan por estas reglas). Desde el navegador solo puede leerlo el admin.
    match /accesos/{id} {
      allow read: if esAdmin();
      allow write: if false;
    }
    match /miembros_actividad/{id} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // Todo lo demás (CRM: events, people, signups…) solo para el admin.
    match /{document=**} {
      allow read, write: if esAdmin();
    }
  }
}
